library(tidyverse)
library(openxlsx)
library(dplyr)
library(ggrepel)
library(RColorBrewer)
library(pheatmap)
library(data.table)
library(GenomicFeatures)
library(rtracklayer)
library(GenomicRanges)
wDir <- paste0("~/gitClones/08_deconvTable/")
fprefix <- "08_deconvTable_germline"
dataDir <- paste0(wDir, "/081_Data/")
resDir <- paste0(wDir, "/083_Results/")
dir.create(resDir)
plotDir <- paste0(wDir, "/084_Plots/", fprefix, "/")
dir.create(plotDir)
germline <- read_table(paste0(dataDir, "Data_S1D_Tasmanian_devil_germline_variants.txt"),
col_types = cols(.default = "c"))
germlineLong <- germline %>%
filter(nchar(REF) == 1, nchar(ALT) == 1)   %>%
pivot_longer(
cols = -c(CHROM, POS, REF, ALT),
names_to = "sample",
values_to = "ratio"
) %>%
mutate(chrom = as.character(CHROM),
location = paste0(CHROM, ":", POS),
position = as.numeric(POS),
sampleType = str_extract(sample, "T|H"),   # T or H at end
tcgId = stringr::str_extract(sample, "^[^TH]+")           # remove T/H suffix
) %>%
dplyr::select(CHROM, POS, REF, ALT, tcgId, sampleType, ratio, sample) %>%
pivot_wider(
names_from = sampleType,
values_from = c(ratio, sample) # Keep original sample column name from vcf file.
)
